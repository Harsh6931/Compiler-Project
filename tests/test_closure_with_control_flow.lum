// Capture + if/while inside inner fn
fn make() {
    let n = 0;
    fn run() {
        let i = 0;
        while (i < 3) {
            n = n + 1;
            i = i + 1;
        }
        if (n > 2) {
            return n;
        }
        return 0;
    }
    return run;
}

let f = make();
print f();
// Expected: 3
